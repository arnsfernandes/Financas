# OpenAI API key with vision access (required)
OPENAI_API_KEY=sk-...

# Optional model and image overrides
VISION_MODEL=gpt-4o
MAX_IMAGE_PX=2048

# Supabase / PostgreSQL Persistence (optional)
# Set these to persist transactions and items into your Supabase database.
# When left unset, persistence returns an in-memory stored receipt.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 original-image storage (optional)
# Leave these unset to run without object storage; scanning still works.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Web Direct Access Authentication
WEB_ACCESS_PASSWORD=
WEB_SESSION_SECRET=
